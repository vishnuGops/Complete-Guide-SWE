{
  "name": "@devpromax/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --tsconfig ../../tsconfig.json src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@devpromax/shared": "*",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.6.1",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2"
  }
}
