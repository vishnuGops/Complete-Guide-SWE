{
  "$schema": "../../../docs/schema/tests.schema.json",
  "samples": [
    {
      "name": "repeated first letter",
      "args": ["swiss"],
      "expected": 1,
      "explanation": "s appears three times, so w at index 1 is the first letter appearing exactly once."
    },
    {
      "name": "nothing stands alone",
      "args": ["aabb"],
      "expected": -1,
      "explanation": "Both a and b appear twice, so there is no answer."
    },
    {
      "name": "single letter",
      "args": ["z"],
      "expected": 0,
      "explanation": "One letter cannot repeat, so it stands alone at index 0."
    }
  ],
  "hidden": [
    {"name":"empty message","args":[""],"expected":-1},
    {"name":"one letter","args":["a"],"expected":0},
    {"name":"one letter twice","args":["aa"],"expected":-1},
    {"name":"every letter once","args":["abcdefghijklmnopqrstuvwxyz"],"expected":0},
    {"name":"the answer is the last letter","args":["aabbccddz"],"expected":8},
    {"name":"the answer is the first letter","args":["zaabbcc"],"expected":0},
    {"name":"one letter repeated","args":["aaaaaaaaaa"],"expected":-1},
    {"args":["aaaaaa"],"expected":-1},
    {"args":["ckancihamclfhfkklmnklikgbnanmh"],"expected":23},
    {
      "args": [
        "dgaadagebeabecgcfeadgcaebcgddafcfgaaaddaggacgfecdffefbdgbagdgacdafebfdabfgccdcfffffbcfbfgdbgddgccgdbdcfefaacabbgdbefcfdd"
      ],
      "expected": -1
    },
    {
      "args": [
        ""
      ],
      "expected": -1
    },
    {
      "args": [
        ""
      ],
      "expected": -1
    },
    {
      "args": [
        ""
      ],
      "expected": -1
    },
    {
      "name": "maximum size",
      "args": [
        ""
      ],
      "expected": -1
    }
  ]
}
