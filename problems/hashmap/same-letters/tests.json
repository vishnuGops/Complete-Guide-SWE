{
  "$schema": "../../../docs/schema/tests.schema.json",
  "samples": [
    {
      "name": "a rearrangement",
      "args": ["listen","silent"],
      "expected": true,
      "explanation": "Every letter appears once in both words."
    },
    {
      "name": "the same letters but not the same counts",
      "args": ["apple","aplet"],
      "expected": false,
      "explanation": "`apple` has two `p`s; `aplet` has one, and a `t` besides."
    },
    {
      "name": "different lengths",
      "args": ["aab","ab"],
      "expected": false,
      "explanation": "One word has two `a`s and the other has one."
    }
  ],
  "hidden": [
    {"name":"one letter, matching","args":["a","a"],"expected":true},
    {"name":"one letter, not matching","args":["a","b"],"expected":false},
    {"name":"a repeat, rearranged","args":["aab","aba"],"expected":true},
    {"name":"the same letters at different multiplicities","args":["aab","abb"],"expected":false},
    {"name":"the second word is longer","args":["ab","abc"],"expected":false},
    {"name":"the far end of the alphabet","args":["zyx","xyz"],"expected":true},
    {"args":["aggf","gfga"],"expected":true},
    {"args":["aggf","igig"],"expected":false},
    {"args":["cgcbaggjh","ggbhaccgj"],"expected":true},
    {"args":["cgcbaggjh","dgadfadag"],"expected":false},
    {"args":["ijedcibibfgichidfeigigecbc","fcbiigbeejigiiidgdicehfcbc"],"expected":true},
    {"args":["ijedcibibfgichidfeigigecbc","deigjgcijidbddjdbeiejfafgj"],"expected":false},
    {
      "args": [
        "jediijbjbgehabbjhhahjdeehdfdfbfbeffihejjhfbddjedjafeeajccgbgghceejihijedhjfeicgi",
        "hegfjhejfajbbdiccjgiiifehdejifedhefjeajjhefjdgcdceabdedihefefbdjbgbibajhhjbegjhh"
      ],
      "expected": true
    },
    {
      "args": [
        "jediijbjbgehabbjhhahjdeehdfdfbfbeffihejjhfbddjedjafeeajccgbgghceejihijedhjfeicgi",
        "ceajcajjbejicjdagaagicjgahadgaagicedeehddhfdijaajedaaeghdcgicdbijdabjgeegifhdedd"
      ],
      "expected": false
    },
    {
      "name": "two thousand letters, rearranged",
      "args": [
        "",
        ""
      ],
      "expected": true
    },
    {
      "name": "the stated maximum, rearranged",
      "args": [
        "",
        ""
      ],
      "expected": true
    },
    {
      "name": "the stated maximum, off by one letter",
      "args": [
        "",
        ""
      ],
      "expected": false
    }
  ]
