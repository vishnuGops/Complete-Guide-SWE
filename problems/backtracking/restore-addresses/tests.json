{
  "$schema": "../../../docs/schema/tests.schema.json",
  "samples": [
    {
      "name": "two possible addresses",
      "args": ["25525511135"],
      "expected": ["255.255.11.135","255.255.111.35"],
      "explanation": "The last two numbers can be split in two places."
    },
    {
      "name": "all zeroes",
      "args": ["0000"],
      "expected": ["0.0.0.0"],
      "explanation": "`00` is not a legal number, so each zero stands alone."
    },
    {
      "name": "too many digits",
      "args": ["1111111111111"],
      "expected": [],
      "explanation": "Four numbers hold at most twelve digits."
    }
  ],
  "hidden": [
    {"name":"one digit","args":["0"],"expected":[]},
    {"name":"one digit, not zero","args":["1"],"expected":[]},
    {"name":"five zeroes, which cannot work","args":["00000"],"expected":[]},
    {
      "name": "the largest numbers, twelve digits",
      "args": ["255255255255"],
      "expected": ["255.255.255.255"]
    },
    {"name":"every number one too large","args":["256256256256"],"expected":[]},
    {
      "name": "zeroes in the middle",
      "args": ["101023"],
      "expected": ["1.0.10.23","1.0.102.3","10.1.0.23","10.10.2.3","101.0.2.3"]
    },
    {"args":["9109"],"expected":["9.1.0.9"]},
    {"args":["9191"],"expected":["9.1.9.1"]},
    {"args":["9901010"],"expected":["9.90.10.10","9.90.101.0","99.0.10.10","99.0.101.0"]},
    {"args":["0109999"],"expected":["0.10.99.99","0.109.9.99","0.109.99.9"]},
    {"args":["256256100255"],"expected":[]},
    {"args":["255100255100"],"expected":["255.100.255.100"]},
    {"args":["02550255"],"expected":["0.25.50.255","0.255.0.255"]},
    {"args":["255000"],"expected":["25.50.0.0","255.0.0.0"]},
    {"args":["3737222185"],"expected":["37.37.222.185"]},
    {"args":["0222111111"],"expected":["0.222.111.111"]},
    {"args":["8145"],"expected":["8.1.4.5"]},
    {"args":["5021"],"expected":["5.0.2.1"]},
