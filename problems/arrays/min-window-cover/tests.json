    {"name":"a quota of three from a run of four","args":["aaaa","aaa"],"expected":"aaa"},
    {
      "name": "two stretches of equal length, so the earlier wins",
      "args": ["abcabc","abc"],
      "expected": "abc"
    },
    {"name":"the order of the need does not matter","args":["zzzzabczzzz","cba"],"expected":"abc"},
