{
  "$schema": "../../../docs/schema/tests.schema.json",
  "samples": [
    {
      "name": "the later stretch is shorter",
      "args": ["adobecodebanc","abc"],
      "expected": "banc",
      "explanation": "`adobec` also covers `abc`, but it is longer than `banc`."
    },
    {
      "name": "repeats are counted",
      "args": ["aa","aa"],
      "expected": "aa",
      "explanation": "A single `a` does not cover a need for two."
    },
    {
      "name": "no covering stretch exists",
      "args": ["abc","abcd"],
      "expected": "",
      "explanation": "There is no `d` anywhere in the log."
    }
  ],
  "hidden": [
