{
  "name": "devpromax",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev -w @devpromax/web",
    "dev:server": "npm run dev -w @devpromax/server",
    "build": "npm run build -w @devpromax/shared && npm run build -w @devpromax/server && npm run build -w @devpromax/web",
    "start": "npm run build && node apps/server/dist/start.js",
    "launch": "npm run build && node apps/server/dist/launch/main.js",
    "package:win": "tsx apps/server/src/cli/package.ts --platform win-x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --project server-integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @devpromax/web",
    "perf:lighthouse": "npm run perf:lighthouse -w @devpromax/web",
    "screenshots": "npm run screenshots -w @devpromax/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --pretty",
    "problems:validate": "tsx apps/server/src/cli/problems/validate.ts",
    "problems:schema": "tsx apps/server/src/cli/problems/emit-schema.ts",
    "problems:new": "tsx apps/server/src/cli/problems/new.ts",
    "problems:gen": "tsx apps/server/src/cli/problems/gen.ts",
    "db:backup": "tsx apps/server/src/cli/db.ts backup",
    "db:restore": "tsx apps/server/src/cli/db.ts restore",
    "doctor": "tsx apps/server/src/cli/doctor.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
